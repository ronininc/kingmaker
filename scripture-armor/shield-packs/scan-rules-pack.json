{
  "format": "scripture-armor-rule-pack/1",
  "rules_version": "scan-rules/1",
  "base_rules": "scan-rules/1",
  "src_packs": [
    {
      "rule": "src-eval-call",
      "sev": "high",
      "langs": [
        "js"
      ],
      "re": {
        "source": "\\beval\\s*\\(",
        "flags": ""
      },
      "detail": "eval() executes a string as code"
    },
    {
      "rule": "src-dynamic-function",
      "sev": "high",
      "langs": [
        "js"
      ],
      "re": {
        "source": "new\\s+Function\\s*\\(",
        "flags": ""
      },
      "detail": "new Function() compiles a string into code"
    },
    {
      "rule": "src-vm-run",
      "sev": "high",
      "langs": [
        "js"
      ],
      "re": {
        "source": "\\bvm\\.runIn(NewContext|ThisContext|Context)\\s*\\(|runInNewContext\\s*\\(",
        "flags": ""
      },
      "detail": "vm.runIn* executes a string as code"
    },
    {
      "rule": "src-child-process-exec-interp",
      "sev": "high",
      "langs": [
        "js"
      ],
      "re": {
        "source": "\\b(exec|execSync)\\s*\\(\\s*(`[^`]*\\$\\{|[^)]*\\+)",
        "flags": ""
      },
      "detail": "child_process exec with an interpolated/concatenated command string"
    },
    {
      "rule": "src-child-process",
      "sev": "medium",
      "langs": [
        "js"
      ],
      "re": {
        "source": "child_process",
        "flags": ""
      },
      "detail": "child_process import — process execution surface (inventory)"
    },
    {
      "rule": "src-dynamic-import",
      "sev": "medium",
      "langs": [
        "js"
      ],
      "re": {
        "source": "\\bimport\\s*\\(\\s*[^\\s'\"`)]",
        "flags": ""
      },
      "detail": "dynamic import() of a non-literal specifier"
    },
    {
      "rule": "behavior-remote-activation",
      "sev": "medium",
      "langs": [
        "js"
      ],
      "re": {
        "source": "\\b(createServer|WebSocketServer)\\s*\\(|\\.listen\\s*\\(",
        "flags": ""
      },
      "detail": "opens a listening socket / server — remotely activatable surface [behavior: remote-activation]"
    },
    {
      "rule": "behavior-sensor-access",
      "sev": "high",
      "langs": [
        "js"
      ],
      "re": {
        "source": "getUserMedia|navigator\\.mediaDevices|AVCaptureDevice|kCGWindowList|\\\\\\\\.\\\\pipe\\\\|node-microphone|node-webcam",
        "flags": ""
      },
      "detail": "camera/microphone capture API [behavior: sensor-access]"
    },
    {
      "rule": "src-shell-pipe-exec",
      "sev": "high",
      "langs": [
        "sh"
      ],
      "re": {
        "source": "\\b(curl|wget)\\b[^|\\n]*\\|\\s*(sudo\\s+)?(sh|bash|zsh)\\b",
        "flags": ""
      },
      "detail": "downloads a script and pipes it into a shell"
    },
    {
      "rule": "src-shell-download",
      "sev": "high",
      "langs": [
        "sh"
      ],
      "re": {
        "source": "\\b(curl|wget)\\b[^\\n]*https?:\\/\\/",
        "flags": ""
      },
      "detail": "fetches a remote payload over http(s) — the download half of download-and-execute"
    },
    {
      "rule": "src-shell-eval",
      "sev": "high",
      "langs": [
        "sh"
      ],
      "re": {
        "source": "(^|\\s)eval\\s+",
        "flags": ""
      },
      "detail": "shell eval of a constructed string"
    },
    {
      "rule": "src-shell-decode-exec",
      "sev": "high",
      "langs": [
        "sh"
      ],
      "re": {
        "source": "base64\\s+(-d|--decode)[^|\\n]*\\|\\s*(sh|bash)",
        "flags": ""
      },
      "detail": "base64-decodes into a shell — encoded payload execution"
    },
    {
      "rule": "src-py-eval-exec",
      "sev": "high",
      "langs": [
        "py"
      ],
      "re": {
        "source": "\\b(eval|exec)\\s*\\(",
        "flags": ""
      },
      "detail": "eval/exec of a string as code"
    },
    {
      "rule": "src-py-os-system",
      "sev": "high",
      "langs": [
        "py"
      ],
      "re": {
        "source": "\\bos\\.system\\s*\\(|\\bos\\.popen\\s*\\(",
        "flags": ""
      },
      "detail": "os.system/os.popen shell execution"
    },
    {
      "rule": "src-py-subprocess-shell",
      "sev": "high",
      "langs": [
        "py"
      ],
      "re": {
        "source": "subprocess\\.[a-zA-Z]+\\([^)]*shell\\s*=\\s*True",
        "flags": ""
      },
      "detail": "subprocess with shell=True"
    },
    {
      "rule": "src-py-pickle-loads",
      "sev": "high",
      "langs": [
        "py"
      ],
      "re": {
        "source": "\\bpickle\\.loads?\\s*\\(",
        "flags": ""
      },
      "detail": "pickle deserialization executes embedded opcodes"
    },
    {
      "rule": "behavior-silent-persistence",
      "sev": "high",
      "langs": [
        "js",
        "sh",
        "py",
        "any"
      ],
      "re": {
        "source": "crontab|systemd|\\/etc\\/init\\.d|LaunchAgents|LaunchDaemons|CurrentVersion\\\\Run|RegSetValue|reg add|autostart",
        "flags": "i"
      },
      "detail": "installs a persistence mechanism (cron/systemd/launchd/registry-run) [behavior: silent-persistence]"
    },
    {
      "rule": "behavior-removal-resistance",
      "sev": "medium",
      "langs": [
        "js",
        "sh",
        "py",
        "any"
      ],
      "re": {
        "source": "IsDebuggerPresent|ptrace\\s*\\(|anti-?debug|respawn|watchdog",
        "flags": "i"
      },
      "detail": "anti-analysis or self-respawn mechanism [behavior: removal-resistance]"
    }
  ],
  "source_sniffs": [
    {
      "source": "\\b(?:eval|exec)\\s*\\(",
      "flags": ""
    },
    {
      "source": "\\bos\\.(?:system|popen)\\s*\\(",
      "flags": ""
    },
    {
      "source": "\\bsubprocess\\.",
      "flags": ""
    },
    {
      "source": "\\b__import__\\s*\\(|\\bpickle\\.loads?\\s*\\(",
      "flags": ""
    },
    {
      "source": "\\bdef\\s+[A-Za-z_]\\w*\\s*\\(",
      "flags": ""
    },
    {
      "source": "^\\s*(?:from\\s+[\\w.]+\\s+import\\s|import\\s+[\\w.]+)",
      "flags": "m"
    },
    {
      "source": "\\|\\s*(?:sudo\\s+)?(?:sh|bash|zsh)\\b",
      "flags": ""
    },
    {
      "source": "\\bchild_process\\b",
      "flags": ""
    },
    {
      "source": "\\brequire\\s*\\(",
      "flags": ""
    },
    {
      "source": "\\bconsole\\.log\\s*\\(|\\bmodule\\.exports\\b",
      "flags": ""
    },
    {
      "source": "^\\s*(?:const|let|var|function|class|async\\s+function)\\s",
      "flags": "m"
    }
  ],
  "binary": {
    "exec_sinks": [
      "CreateProcess",
      "CreateProcessA",
      "CreateProcessW",
      "ShellExecute",
      "ShellExecuteEx",
      "WinExec",
      "_spawnl",
      "_spawnlp",
      "_spawnv",
      "_spawnvp",
      "execl",
      "execle",
      "execlp",
      "execv",
      "execve",
      "execvp",
      "execvpe",
      "popen",
      "system"
    ],
    "unbounded_sinks": [
      "gets",
      "sprintf",
      "stpcpy",
      "strcat",
      "strcpy",
      "vsprintf",
      "wcscat",
      "wcscpy"
    ],
    "import_categories": [
      {
        "cat": "process-injection",
        "sev": "high",
        "behavior": null,
        "names": [
          "CreateRemoteThread",
          "NtCreateThreadEx",
          "QueueUserAPC",
          "SetWindowsHookEx",
          "VirtualAllocEx",
          "WriteProcessMemory",
          "dllinjection"
        ]
      },
      {
        "cat": "persistence",
        "sev": "high",
        "behavior": "silent-persistence",
        "names": [
          "CreateService",
          "CreateServiceA",
          "CreateServiceW",
          "RegCreateKeyEx",
          "RegSetValue",
          "RegSetValueEx",
          "StartServiceCtrlDispatcher"
        ]
      },
      {
        "cat": "network-control",
        "sev": "high",
        "behavior": "remote-activation",
        "names": [
          "HttpSendRequest",
          "InternetConnect",
          "InternetOpen",
          "InternetOpenA",
          "InternetOpenW",
          "WSAStartup",
          "accept",
          "bind",
          "connect",
          "listen",
          "socket"
        ]
      },
      {
        "cat": "sensor-access",
        "sev": "high",
        "behavior": "sensor-access",
        "names": [
          "BitBlt",
          "GetDC",
          "avicap32",
          "capCreateCaptureWindow",
          "mciSendString",
          "waveInOpen"
        ]
      },
      {
        "cat": "removal-resistance",
        "sev": "medium",
        "behavior": "removal-resistance",
        "names": [
          "CheckRemoteDebuggerPresent",
          "IsDebuggerPresent",
          "NtQueryInformationProcess",
          "ptrace"
        ]
      }
    ],
    "input_fns": [
      "InternetReadFile",
      "__isoc99_scanf",
      "accept",
      "fgets",
      "fread",
      "fscanf",
      "getenv",
      "getline",
      "getopt",
      "getopt_long",
      "gets",
      "read",
      "recv",
      "recvfrom",
      "scanf",
      "sscanf"
    ]
  },
  "weights": {
    "critical": 40,
    "high": 15,
    "medium": 5,
    "low": 2,
    "cap": 100
  },
  "composite": {
    "promote": [
      "src-eval-call",
      "src-dynamic-function",
      "src-vm-run",
      "src-child-process-exec-interp",
      "src-shell-pipe-exec",
      "src-shell-eval",
      "src-shell-decode-exec",
      "src-shell-download",
      "src-py-eval-exec",
      "src-py-os-system",
      "src-py-subprocess-shell",
      "src-py-pickle-loads"
    ],
    "family": {
      "src-eval-call": "eval-exec",
      "src-py-eval-exec": "eval-exec"
    }
  },
  "tier_defaults": {
    "0": {
      "expiry_cap_hours": null,
      "reseal_hours": null,
      "dual_approval": false,
      "min_cell": "policy-default",
      "downgrade_allowed": true,
      "egress": "any",
      "reverify": "registration+first",
      "scan_max_age_hours": null,
      "beacon_anomaly": false
    },
    "1": {
      "expiry_cap_hours": 168,
      "reseal_hours": 720,
      "dual_approval": false,
      "min_cell": "hard",
      "downgrade_allowed": true,
      "egress": "peers+airlock",
      "reverify": "every-activation",
      "scan_max_age_hours": null,
      "beacon_anomaly": false
    },
    "2": {
      "expiry_cap_hours": 24,
      "reseal_hours": 24,
      "dual_approval": true,
      "min_cell": "hard",
      "downgrade_allowed": false,
      "egress": "airlock-only",
      "reverify": "every-activation+freshness",
      "scan_max_age_hours": 24,
      "beacon_anomaly": true
    }
  }
}