# Solomon server environment template — for SERVER mode only.
#
# Which file is read (contract C8):
# - `npm --prefix server run dev|start` and the Windows .bat launcher read server/.env (copy this file
#   to server/.env; `npm --prefix server start` also runs without one).
# - `npm run desktop:run` and the packaged desktop app IGNORE server/.env. They read only
#   <userData>/runtime/.env (written on first launch; see SETUP.md "Where things live") plus the
#   credentials added in Settings -> Connectors.
#
# Posture on the owner's own machine (sovereign local-owner mode):
# - a request from this machine's loopback is the owner, signed in as ROOT with no password prompt;
#   relayed requests (tunnels, other devices) are not;
# - the local licence is ACTIVE (licenseId sovereign-local-owner) — no activation token is needed;
# - high-risk actions are allowed but always proposal/confirm-gated and audited;
# - SOLOMON_REQUIRE_LOGIN=1 turns the password wall back on for this machine.
# The owner account is created on first start as SOLOMON_PRIMARY_OWNER_EMAIL, or owner@solomon.local
# when it is unset — set it BEFORE the first start.

# OPERATOR_API_KEY is loaded into the server config but no auth path currently checks it; account
# login (above) is what protects the API. Leave it blank unless support tells you otherwise.
OPERATOR_API_KEY=

# Startup posture defaults.
# Use "local" for safe local validation.
# Use "production" only after validating real connectors.
SOLOMON_MODE=local
SOLOMON_EXECUTION_MODE=standard
PORT=3001

# Optional runtime depth mode.
# Leave blank for full internal depth.
# Use "demo" or "evaluation" only when you intentionally want reduced output depth.
SOLOMON_LICENSE_MODE=

# On the owner's own machine the licence is active locally (see above). A signed activation token is
# only relevant outside sovereign local-owner mode; it is stored by the app, never in this file.

# Local-safe connector baseline.
# Replace through the guided config flow instead of editing this by hand when possible.
SOLOMON_PROVIDER=local
SOLOMON_PROVIDERS=local
SOLOMON_CONNECTORS=[{"id":"local-core","type":"local","label":"Solomon Core","enabled":true,"order":0,"model":"solomon-core-v1","auth":{},"config":{}}]

# Optional LLM connector credentials.
# Leave blank until you are ready to validate a real external provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Kimi‑K2 via Ollama Cloud — the non‑Claude OVERFLOW BOOSTER (local model first → Kimi → NIM → Claude
# last). Set OLLAMA_API_KEY to enable it across the reasoning ladder, the delegation spine, and the
# secure codegen lane at once. SOLOMON_KIMI_MODEL sets the exact Ollama Cloud tag (e.g. kimi-k2.7);
# any Ollama Cloud model works (e.g. glm-5.3) and delegations are driven by its playbook when one exists;
# SOLOMON_KIMI_ENABLED=0 is the kill-switch. A cloud call only ever carries non-sensitive content
# (the egress firewall's external-llm lane keeps customer/operational data off it).
OLLAMA_API_KEY=
SOLOMON_KIMI_MODEL=kimi-k2
# SOLOMON_KIMI_BASE_URL=https://ollama.com/v1
# SOLOMON_KIMI_ENABLED=1

# Model Router, LAN hosts: big models on other machines on YOUR local network (never the cloud). Voice,
# classification and governance stay on this Mac's small model; deep reasoning, research and batch work go
# to a verified big host. Addresses must be local (loopback, 10/8, 172.16/12, 192.168/16, link-local,
# a .local name, or Tailscale 100.64/10); a public address is refused. kind: "ollama" or
# "openai-compatible" (mlx_lm.server, llama-server). A host token is never written here: set
# "auth": "sealed-token" and seal it. Or put the same JSON in <data root>/models/lan-hosts.json
# (SOLOMON_LAN_HOSTS_FILE moves it). Check them: npm run solomon:lan-hosts, or GET /api/capacity/lan-hosts?verify=1
# SOLOMON_LAN_HOSTS=[{"id":"m5","label":"M5 Mac","baseUrl":"http://m5.local:11434","kind":"ollama","role":"big","memoryGb":24}]
# Using those machines is an OPTION, off until you turn it on in Settings ▸ Other computers on my network
# (written to the hosts file as "enabled": true). This overrides the switch either way:
# SOLOMON_LAN_OFFLOAD=on

# Web research: Solomon's governed, read-only internet lane is enabled by default (the desktop app
# discloses it on first run). SOLOMON_INTERNET_ACCESS=0 always forces it off (fully local).
# SOLOMON_INTERNET_ACCESS=0
# Optional Tavily search integration (SEARCH_API_KEY is sent the question text when set).
SOLOMON_WEB_SEARCH_ENABLED=false
SEARCH_API_PROVIDER=tavily
SEARCH_API_KEY=

# Optional PostgreSQL defaults for the built-in postgres connector.
# Solomon reuses these values when you validate or enable a postgres connector.
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=disable

# Optional browser origins for the local operator UI.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
