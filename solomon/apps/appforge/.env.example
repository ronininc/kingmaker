# ---- Ronin App Forge · environment ----
# Copy to .env and fill in. NEVER commit real keys.

# --- Server ---
APPFORGE_HOST=0.0.0.0
APPFORGE_PORT=8090
SESSION_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8090

# --- Database ---
DATABASE_URL=sqlite:///./data/appforge.db

# --- Operator access ---
# A secret code (>=12 chars) that bypasses the paywall for you (owner). Leave blank to disable.
# The paywall stays locked for everyone else. Generate: python -c "import secrets;print(secrets.token_urlsafe(12))"
ADMIN_UNLOCK_CODE=
# Local dev only: allow booting with the placeholder SESSION_SECRET above. NEVER set true in production.
ALLOW_INSECURE_SECRET=false
# Local dev only: enable POST /billing/dev-activate (self-activate without paying). Keep false in prod.
ENABLE_DEV_ACTIVATE=false

# --- Stripe (test mode to start) — $500/mo, SAME Stripe account as Ronin Lead Engine ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional — leave blank to use admin-editable pricing (set from the admin login via Stripe price_data).
STRIPE_PRICE_ID=
STRIPE_PORTAL_CONFIG_ID=

# --- Planner model (OpenAI-compatible server: Ollama or vLLM). Leave blank to use the
#     deterministic heuristic planner (a real, simple app-spec; no fabricated capability). ---
MODEL_BASE_URL=            # e.g. http://localhost:11434/v1  (Ollama)   or  http://localhost:8000/v1 (vLLM)
MODEL_API_KEY=             # Ollama ignores this; vLLM may require a token
MODEL_NAME=qwen3-coder     # Apache-2.0 coding model

# --- Backend-as-a-Service (provisioned BEFORE codegen). Configure ONE, or neither (generated app
#     falls back to local storage so it still runs). ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
POCKETBASE_URL=
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- Codegen engine (optional). Blank => the deterministic built-in generator produces a real,
#     runnable CRUD app from the spec. Set to shell out to a stronger agent when installed. ---
CODEGEN_ENGINE=builtin     # builtin | openhands | aider
OPENHANDS_URL=             # headless OpenHands runtime endpoint, if CODEGEN_ENGINE=openhands

# --- Deploy target (optional). Blank => download the generated app; wire Coolify to auto-deploy. ---
COOLIFY_URL=
COOLIFY_TOKEN=
COOLIFY_PROJECT_ID=
