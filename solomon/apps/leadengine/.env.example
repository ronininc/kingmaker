# ---- Ronin Lead Engine · environment ----
# Copy to .env and fill in. NEVER commit real keys.

# --- Server ---
LEADENGINE_HOST=0.0.0.0
LEADENGINE_PORT=8830
# Secret used to sign session JWTs. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-a-long-random-string
# Public origin used for Stripe success/cancel redirects
PUBLIC_BASE_URL=http://localhost:8830

# --- Database ---
# Default is a local SQLite file. Swap to Postgres by setting a postgresql+psycopg URL.
DATABASE_URL=sqlite:///./data/leadengine.db

# --- Operator access ---
# A secret code (>=12 chars) that bypasses the paywall for you (owner). Leave blank to disable.
# The paywall stays locked for everyone else. Generate: python -c "import secrets;print(secrets.token_urlsafe(12))"
ADMIN_UNLOCK_CODE=
# Local dev only: allow booting with the placeholder SESSION_SECRET above. NEVER set true in production.
ALLOW_INSECURE_SECRET=false
# Local dev only: enable POST /billing/dev-activate (self-activate without paying). Keep false in prod.
ENABLE_DEV_ACTIVATE=false

# --- Stripe (test mode to start) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional — leave blank to use admin-editable pricing (set from the admin login via Stripe price_data).
STRIPE_PRICE_ID=
# Optional: Stripe customer-portal config id (billing management). Leave blank to skip.
STRIPE_PORTAL_CONFIG_ID=

# --- Enrichment endpoints (public dev endpoints; self-host for volume) ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Contact string sent as the OSM User-Agent / email param (OSM usage policy requires identifying yourself)
OSM_CONTACT=leads@ronininc.org

# --- Feature flags ---
# SMTP mailbox verification (Reacher/check-if-email-exists). OFF by default:
# needs outbound port 25 (blocked on most clouds) and is AGPL-3.0 (self-hosted only).
ENABLE_SMTP_VERIFY=false
REACHER_URL=

# Cap how many candidates get expensive enrichment (protects rate limits + cost)
ENRICH_TOP_N=150
# Target size of the final ranked list
FINAL_LEAD_COUNT=100
# Seed universe target before cheap scoring
SEED_TARGET=400
