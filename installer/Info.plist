<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Kingmaker Installer.app's Info.plist; scripts/build-installer.sh fills @VERSION@ and @RELEASE@. -->
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>Kingmaker Installer</string>
  <key>CFBundleDisplayName</key><string>Kingmaker Installer</string>
  <key>CFBundleIdentifier</key><string>com.ronininc.kingmaker.installer</string>
  <key>CFBundleExecutable</key><string>Kingmaker Installer</string>
  <key>CFBundleIconFile</key><string>InstallerIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>KingmakerRelease</key><string>@RELEASE@</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
  <!-- The terms hook: the Download & Install button needs the "I accept" box (TERMS.md is readable in the window).
       Wording pending the operator's legal decision; false turns the requirement off without removing it. -->
  <key>KingmakerTermsRequired</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSHumanReadableCopyright</key><string>Ronin Inc. Free for personal and noncommercial use (PolyForm Noncommercial 1.0.0).</string>
  <key>NSAppleEventsUsageDescription</key><string>The installer asks a running Kingmaker to quit before it replaces it, and asks macOS for your password once if Apple’s Command Line Tools or Homebrew must be installed.</string>
</dict></plist>
