{
  // The collective's front door (docs/community-learning.md). Not deployed until the owner says so.
  // Before deployment: separately approve SQLite migration and audit prior KV state; set the key pair:
  //   node scripts/fleet-keygen.mjs   (prints the public key for FLEET_PUBLIC_KEY; pipe the private key to the secret)
  //   wrangler secret put FLEET_SIGNING_KEY
  "name": "kingmaker-fleet",
  "main": "index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Review-only: activation requires separate approved deployment/migration.
  "durable_objects": {"bindings":[{"name":"FLEET_COORDINATOR","class_name":"FleetCoordinator"}]},
  "migrations": [{"tag":"fleet-coordinator-v1","new_sqlite_classes":["FleetCoordinator"]}],
  "vars": { "FLEET_PUBLIC_KEY": "SET-BEFORE-DEPLOY" }
}
