+# ── the signed library manifest (v0.4.1) ─────────────────────────────────────────────────────────────────────────
+# Corpora no longer ride the install: each confirmed corpus is an object set under library/ on the same source the
+# parts came from, listed file by file (path, size, sha256) in a library manifest whose detached signature is
+# checked against the same pinned release key as the release manifest. A release that carries no library manifest
+# keeps the 0.4.0 bootstrap path untouched; one that carries a manifest which does not verify ends the install.
+LIB_MANIFEST_FILE="$CACHE/kingmaker-library-manifest.json"
+LIB_MANIFEST_OK=0
+lmf() { plutil -extract "$1" raw -o - "$LIB_MANIFEST_FILE" 2>/dev/null; }
+lmfn() { local v; v="$(lmf "$1")" || { echo 0; return; }; case "$v" in ''|*[!0-9]*) echo 0 ;; *) echo "$v" ;; esac; }
+verify_detached() { # verify_detached <file> <base64 signature file>: 0 = verifies against the pinned release key
+  local bin="$CACHE/.detached.sig.bin" rc
+  [ -s "$RELEASE_PUBKEY" ] || return 1
+  command -v openssl >/dev/null 2>&1 || return 1
+  base64 -D -i "$2" -o "$bin" 2>>"$LOG" || base64 -d -i "$2" -o "$bin" 2>>"$LOG" || return 1
+  openssl dgst -sha256 -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:-1 -verify "$RELEASE_PUBKEY" -signature "$bin" "$1" >>"$LOG" 2>&1; rc=$?
+  rm -f "$bin"; return "$rc"
+}
+fetch_library_manifest() { # 0 = a signature-verified library manifest sits in $LIB_MANIFEST_FILE; 1 = none carried
+  local name src sigsrc sauth=0 id sid
+  name="$(mf knowledge.libraryManifest)"; case "$name" in ''|null) return 1 ;; esac
+  case "$name" in */*|.*) fail "The release manifest has a bad library manifest name." ;; esac
+  if [ -n "$SOURCE" ]; then src="$(cd "$SOURCE" && pwd -P)/$name"; sigsrc="$src.sig"
+  elif [ -n "$BASE_URL" ]; then src="${BASE_URL%/}/$name"; sigsrc="$src.sig"; [ -n "$AUTH_HEADER" ] && sauth=1
+  elif [ -n "$TOKEN" ]; then
+    id="$(asset_id "$name")" || return 1; sid="$(asset_id "$name.sig")" || return 1
+    src="$GITHUB_API/repos/$REPO/releases/assets/$id"; sigsrc="$GITHUB_API/repos/$REPO/releases/assets/$sid"; sauth=1
+  else src="https://github.com/$REPO/releases/download/$TAG/$name"; sigsrc="$src.sig"; fi
+  rm -f "$LIB_MANIFEST_FILE" "$LIB_MANIFEST_FILE.sig"
+  case "$src" in
+    /*) { cp "$src" "$LIB_MANIFEST_FILE" && cp "$sigsrc" "$LIB_MANIFEST_FILE.sig"; } 2>>"$LOG" || return 1 ;;
+    *) if [ "$sauth" = 1 ]; then
+         curl -fsSL --max-time 60 -H @"$AUTH_HEADER" -H "Accept: application/octet-stream" -o "$LIB_MANIFEST_FILE" "$src" 2>>"$LOG" || return 1
+         curl -fsSL --max-time 60 -H @"$AUTH_HEADER" -H "Accept: application/octet-stream" -o "$LIB_MANIFEST_FILE.sig" "$sigsrc" 2>>"$LOG" || return 1
+       else
+         curl -fsSL --max-time 60 -o "$LIB_MANIFEST_FILE" "$src" 2>>"$LOG" || return 1
+         curl -fsSL --max-time 60 -o "$LIB_MANIFEST_FILE.sig" "$sigsrc" 2>>"$LOG" || return 1
+       fi ;;
+  esac
+  [ "$(lmf schema)" = "kingmaker.library/1" ] || fail "The library manifest is not one this installer understands ($(lmf schema))."
+  verify_detached "$LIB_MANIFEST_FILE" "$LIB_MANIFEST_FILE.sig" || fail "The library manifest's signature does NOT match Ronin Inc.'s key. Refusing to trust the hashes in it."
+  LIB_MANIFEST_OK=1
+  note "The library manifest is signed by Ronin Inc.'s release key; every library file is checked against it."
+  return 0
+}
+verify_library_files() { # verify_library_files <sources dir>: every listed file present, right size, right sha256
+  local root="$1" n i id m j path sha size
+  n="$(lmfn corpora)"; [ "$n" -ge 1 ] || fail "The signed library manifest lists no corpora."
+  i=0
+  while [ "$i" -lt "$n" ]; do
+    id="$(lmf "corpora.$i.id")"
+    m="$(lmfn "corpora.$i.files")"
+    j=0
+    while [ "$j" -lt "$m" ]; do
+      path="$(lmf "corpora.$i.files.$j.path")"; sha="$(lmf "corpora.$i.files.$j.sha256")"; size="$(lmfn "corpora.$i.files.$j.size")"
+      case "$path" in ''|/*|*../*) fail "The signed library manifest has a bad file path for corpus $id." ;; esac
+      [ -f "$root/$path" ] || fail "The knowledge library is missing $path (corpus $id). What came down is kept: press Download & Install again to resume."
+      [ "$(fsize "$root/$path")" = "$size" ] || fail "$path has the wrong size against the signed library manifest. What came down is kept: press Download & Install again to resume."
+      [ "$(sha256 "$root/$path")" = "$sha" ] || fail "$path does not match the signed library manifest's sha256, so it did not come from Ronin Inc.'s library. Press Download & Install again to fetch it fresh."
+      j=$((j + 1))
+    done
+    i=$((i + 1))
+  done
+}
